# Contact form (app/api/contact/route.ts) — server-only, never exposed to the client.

# Required. Resend API key (dashboard.resend.com -> API Keys).
RESEND_API_KEY=

# Optional. Destination inbox for contact-form leads.
# Defaults to hello@kitegrowth.com if unset.
CONTACT_TO_EMAIL=hello@kitegrowth.com

# Optional. Sender identity leads are sent "from".
# Must be on a domain verified in Resend for production use.
# Defaults to Resend's shared test sender, which only works for onboarding/testing.
CONTACT_FROM_EMAIL="KITE Website <onboarding@resend.dev>"
